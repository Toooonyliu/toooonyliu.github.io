{
  "name": "demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test": "tsx --test tests/recall-*.test.mjs",
    "test:runtime": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/build-server.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node app/server.js",
    "start:stand-in": "MIBLY_STAND_IN=1 node app/server.js",
    "build:server": "node scripts/build-server.mjs"
  },
  "dependencies": {
    "express": "4.21.2"
  },
  "devDependencies": {
    "@fontsource/roboto": "5.2.10",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "1.61.1",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@types/leaflet": "1.9.20",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@use-gesture/react": "10.3.1",
    "@vitejs/plugin-react": "6.0.3",
    "esbuild": "0.28.2",
    "leaflet": "1.9.4",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  },
  "engines": {
    "node": ">=18"
  }
}
